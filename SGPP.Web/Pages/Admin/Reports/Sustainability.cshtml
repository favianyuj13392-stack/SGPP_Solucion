@page
@model SGPP.Web.Pages.Admin.Reports.SustainabilityModel
@{
    ViewData["Title"] = "Dashboard de Sostenibilidad";
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h2 class="text-primary"><i class="fas fa-chart-line"></i> Dashboard de Sostenibilidad</h2>
        <p class="text-muted">Análisis estratégico de convenios y distribución de estudiantes.</p>
    </div>
    <div class="col-md-4 text-end">
        <form method="post" asp-page-handler="Export">
            <button type="submit" class="btn btn-success shadow-sm">
                <i class="fas fa-file-excel"></i> Descargar Reporte (.xlsx)
            </button>
        </form>
    </div>
</div>

<div class="row g-4">
    <!-- Chart 1: Top Empresas -->
    <div class="col-lg-6">
        <div class="card shadow-sm mb-4 border-0 h-100">
            <div class="card-header py-3" style="background-color: #003366; color: white;">
                <h6 class="m-0 fw-bold"><i class="fas fa-building me-2"></i>Empresas con Mayor Captación (Top 10)</h6>
            </div>
            <div class="card-body">
                <div style="height: 380px; position: relative;">
                    <canvas id="companiesChart"></canvas>
                </div>
            </div>
            <div class="card-footer bg-light border-0 small text-muted text-center">
                <i class="fas fa-info-circle me-1 text-primary"></i> Empresas líderes con mayor volumen de estudiantes vinculados.
            </div>
        </div>
    </div>

    <!-- Chart 2: Areas -->
    <div class="col-lg-6">
        <div class="card shadow-sm mb-4 border-0 h-100">
            <div class="card-header py-3" style="background-color: #003366; color: white;">
                <h6 class="m-0 fw-bold"><i class="fas fa-chart-pie me-2"></i>Distribución por Macro-Áreas de Trabajo</h6>
            </div>
            <div class="card-body">
                <div style="height: 380px; position: relative;">
                    <canvas id="areasChart"></canvas>
                </div>
            </div>
            <div class="card-footer bg-light border-0 small text-muted text-center">
                <i class="fas fa-check-circle me-1 text-success"></i> Representación porcentual de inserción por sector laboral.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Data passed from Model
        const companyLabels = @Json.Serialize(Model.CompanyChart.Labels);
        const companyValues = @Json.Serialize(Model.CompanyChart.Values);
        const areaLabels = @Json.Serialize(Model.AreaChart.Labels);
        const areaValues = @Json.Serialize(Model.AreaChart.Values);

        // Chart 1: Companies (Horizontal Bar)
        const ctxCompanies = document.getElementById('companiesChart').getContext('2d');
        new Chart(ctxCompanies, {
            type: 'bar',
            data: {
                labels: companyLabels,
                datasets: [{
                    label: 'Estudiantes Asignados',
                    data: companyValues,
                    backgroundColor: 'rgba(0, 51, 102, 0.85)',
                    borderColor: '#003366',
                    borderWidth: 1,
                    borderRadius: 4,
                    hoverBackgroundColor: '#FFCC00'
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    x: {
                        beginAtZero: true,
                        ticks: { stepSize: 1 },
                        title: { display: true, text: 'Cantidad de Estudiantes' }
                    },
                    y: {
                        ticks: {
                            callback: function(value) {
                                const label = this.getLabelForValue(value);
                                return label.length > 25 ? label.substr(0, 25) + '…' : label;
                            }
                        }
                    }
                },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            title: function(items) {
                                return items[0].label;
                            },
                            label: function(item) {
                                return 'Estudiantes asignados: ' + item.raw;
                            }
                        }
                    }
                }
            }
        });

        // Chart 2: Areas (Executive Doughnut)
        // Palette: UCB Blue, UCB Gold, Teal, Royal Blue, Orange, Purple, Slate Gray
        const executivePalette = ['#003366', '#FFCC00', '#20c997', '#0d6efd', '#fd7e14', '#6f42c1', '#6c757d'];
        const totalAreaStudents = areaValues.reduce((a, b) => a + b, 0);

        const ctxAreas = document.getElementById('areasChart').getContext('2d');
        new Chart(ctxAreas, {
            type: 'doughnut',
            data: {
                labels: areaLabels,
                datasets: [{
                    data: areaValues,
                    backgroundColor: executivePalette,
                    borderWidth: 2,
                    borderColor: '#ffffff',
                    hoverOffset: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            boxWidth: 14,
                            padding: 12,
                            font: { size: 11, family: "'Segoe UI', sans-serif" }
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(ctx) {
                                const val = ctx.raw;
                                const pct = totalAreaStudents > 0 ? ((val / totalAreaStudents) * 100).toFixed(1) : 0;
                                return ' ' + ctx.label + ': ' + val + ' (' + pct + '%)';
                            }
                        }
                    }
                }
            }
        });
    </script>
}
