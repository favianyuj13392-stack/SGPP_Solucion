@page
@model SGPP.Web.Pages.Account.LockoutModel
@{
    ViewData["Title"] = "Cuenta Bloqueada Temporalmente";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-0 p-4 p-md-5 rounded-4 text-center bg-white">
                <div class="mb-3 text-warning">
                    <i class="fas fa-user-lock fa-4x"></i>
                </div>
                <h2 class="h3 fw-bold text-ucb-blue mb-2">Cuenta Bloqueada Temporalmente</h2>
                <p class="text-muted small mb-4">
                    Por motivos de seguridad institucional, esta cuenta ha sido bloqueada temporalmente tras registrarse múltiples intentos fallidos de acceso con contraseñas incorrectas.
                </p>
                
                <div class="alert alert-warning text-start small mb-4" role="alert">
                    <div class="d-flex">
                        <i class="fas fa-clock fa-lg me-2 mt-1"></i>
                        <div>
                            <strong>¿Qué debes hacer?</strong><br>
                            El bloqueo se levantará automáticamente en unos minutos. Asegúrate de ingresar con tu contraseña temporal oficial (<code>Ucb.{TuCodigoEstudiante}!</code>) y no con tus credenciales de SIAAN/LMS.
                        </div>
                    </div>
                </div>

                <div>
                    <a href="/Account/Login" class="btn btn-primary px-4 py-2 fw-semibold">
                        <i class="fas fa-arrow-left me-1"></i> Volver a Iniciar Sesión
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
