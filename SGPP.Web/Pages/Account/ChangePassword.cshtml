@page
@model SGPP.Web.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Actualizar Contraseña";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0 rounded-lg">
                <div class="card-header text-center" style="background-color: #004070; color: #FFFFFF;">
                    <img src="~/img/ucb_logo.png" alt="UCB Logo" height="70" class="my-3">
                    <h4 class="font-weight-light mb-1">Actualización de Contraseña</h4>
                    <p class="small text-white-50 mb-0">Sistema de Gestión de Prácticas Profesionales</p>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-info d-flex align-items-center mb-4" role="alert">
                        <i class="fas fa-shield-alt fa-2x me-3 text-primary"></i>
                        <div class="small">
                            <strong>Primer inicio de sesión detectado:</strong> Por motivos de seguridad institucional, debes cambiar tu contraseña temporal antes de acceder al sistema.
                        </div>
                    </div>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.CurrentPassword" class="form-control" type="password" placeholder="Contraseña Actual" autocomplete="current-password" />
                            <label asp-for="Input.CurrentPassword"></label>
                            <span asp-validation-for="Input.CurrentPassword" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.NewPassword" class="form-control" type="password" placeholder="Nueva Contraseña" autocomplete="new-password" />
                            <label asp-for="Input.NewPassword"></label>
                            <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
                            <div class="form-text small text-muted">
                                Mínimo 6 caracteres, incluyendo mayúsculas, minúsculas, números y un símbolo.
                            </div>
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="Input.ConfirmPassword" class="form-control" type="password" placeholder="Confirmar Nueva Contraseña" autocomplete="new-password" />
                            <label asp-for="Input.ConfirmPassword"></label>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-lg fw-bold shadow-sm" style="background-color: #F5C002; color: #004070;">
                                <i class="fas fa-key me-2"></i>Guardar y Continuar
                            </button>
                        </div>
                    </form>
                </div>
                <div class="card-footer text-center py-3 bg-light">
                    <form method="post" asp-page="./Logout" class="d-inline">
                        <button type="submit" class="btn btn-link btn-sm text-decoration-none text-muted">
                            <i class="fas fa-sign-out-alt me-1"></i>Cerrar Sesión
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
